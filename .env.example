# ─────────────────────────────────────────────────────────────────────────
# FutCaixa — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores do seu
# projeto Supabase (Dashboard → Project Settings → API).
# NUNCA faça commit do `.env.local` nem exponha a service role no cliente.
# ─────────────────────────────────────────────────────────────────────────

# URL do projeto Supabase (pública) — ex.: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública) do Supabase — usada no cliente e no servidor com a
# sessão do usuário. Respeita a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role (SECRETA, SOMENTE servidor) — contorna a RLS.
# Usada por rotas de cron e operações administrativas. Nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para proteger os Route Handlers de cron (gerar-mensalidades,
# gerar-recorrentes). No Render não há cron nativo gratuito, então um agendador
# externo (cron-job.org, Upstash QStash etc.) dispara as rotas e você configura
# manualmente o header `Authorization: Bearer <CRON_SECRET>` nesse agendador.
# Gere um valor aleatório forte, ex.: `openssl rand -hex 32`. Veja docs/crons.md.
CRON_SECRET=
